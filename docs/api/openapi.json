{
  "openapi": "3.0.3",
  "info": {
    "title": "CMH — API de Imóveis",
    "version": "1.0.0",
    "description": "API da Entrega 1. Sem autenticação. Datas de exemplo devem ser ajustadas para hoje ou futuro. Contrato baseado em specs.md e requirements.md."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Laravel local"
    }
  ],
  "tags": [
    {
      "name": "Imóveis"
    }
  ],
  "paths": {
    "/imoveis": {
      "get": {
        "operationId": "listarImoveis",
        "summary": "Listar imóveis com filtros e paginação",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "page"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 15,
              "maximum": 100
            },
            "description": "per_page"
          },
          {
            "name": "busca",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Busca parcial em título e endereço."
          },
          {
            "name": "tipo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "casa",
                "apartamento",
                "kitnet",
                "comercial",
                "terreno"
              ]
            },
            "description": "tipo"
          },
          {
            "name": "finalidade",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "venda",
                "aluguel"
              ]
            },
            "description": "finalidade"
          },
          {
            "name": "cidade",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Busca parcial pela cidade."
          },
          {
            "name": "disponivel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "disponivel"
          },
          {
            "name": "preco_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "preco_min"
          },
          {
            "name": "preco_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "preco_max"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedImoveis"
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      },
      "post": {
        "operationId": "cadastrarImovel",
        "summary": "Cadastrar imóvel com foto opcional",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateImovel"
              },
              "example": {
                "titulo": "Casa com quintal para alugar",
                "descricao": "Anúncio de demonstração da collection CMH.",
                "tipo": "casa",
                "finalidade": "aluguel",
                "endereco": "Rua das Palmeiras, 123 - Centro",
                "cidade": "Santos/SP",
                "preco": 2500.75,
                "area_m2": 120.5,
                "quartos": 2,
                "banheiros": 1,
                "vagas": 1,
                "data_disponibilidade": "2026-10-15",
                "disponivel": true,
                "contato_telefone": "(13) 99999-1234"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateImovelMultipart"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imóvel cadastrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Os dados fornecidos são inválidos.",
                  "errors": {
                    "preco": [
                      "O preço deve ser maior ou igual a 0."
                    ],
                    "tipo": [
                      "O tipo selecionado é inválido."
                    ]
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      }
    },
    "/imoveis/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "detalharImovel",
        "summary": "Detalhar imóvel",
        "responses": {
          "200": {
            "description": "Detalhe do anúncio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImovelResponse"
                }
              }
            }
          },
          "404": {
            "description": "Imóvel inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      },
      "put": {
        "operationId": "atualizarImovel",
        "summary": "Atualizar campos por JSON",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateImovel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imóvel atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Os dados fornecidos são inválidos.",
                  "errors": {
                    "preco": [
                      "O preço deve ser maior ou igual a 0."
                    ],
                    "tipo": [
                      "O tipo selecionado é inválido."
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Imóvel inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      },
      "post": {
        "operationId": "atualizarImovelComFoto",
        "summary": "Atualizar via multipart e _method=PUT",
        "description": "O campo _method=PUT é obrigatório nesta operação. PHP não processa arquivos enviados por PUT multipart diretamente.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateImovelMultipart"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imóvel atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Os dados fornecidos são inválidos.",
                  "errors": {
                    "preco": [
                      "O preço deve ser maior ou igual a 0."
                    ],
                    "tipo": [
                      "O tipo selecionado é inválido."
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Imóvel inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      },
      "delete": {
        "operationId": "excluirImovel",
        "summary": "Excluir imóvel e sua foto",
        "responses": {
          "204": {
            "description": "Excluído; corpo vazio."
          },
          "404": {
            "description": "Imóvel inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      }
    },
    "/imoveis/{id}/foto": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "operationId": "trocarFoto",
        "summary": "Substituir somente a foto",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": {
                    "type": "string",
                    "format": "binary",
                    "description": "Imagem JPEG/JPG, PNG ou WEBP de até 2048 KB."
                  }
                },
                "required": [
                  "foto"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Foto atualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "foto_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "message",
                    "foto_url"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Os dados fornecidos são inválidos.",
                  "errors": {
                    "preco": [
                      "O preço deve ser maior ou igual a 0."
                    ],
                    "tipo": [
                      "O tipo selecionado é inválido."
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Imóvel inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Imóveis"
        ]
      }
    }
  },
