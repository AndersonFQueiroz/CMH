    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tomorrow = new Date(Date.now() + 86400000);",
          "pm.variables.set('data_disponibilidade', tomorrow.toISOString().slice(0,10));"
        ]
      }
    }
  ],
